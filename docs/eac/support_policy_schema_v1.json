{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/upiscium/VillagerAgent/blob/main/docs/eac/support_policy_schema_v1.json",
  "title": "EAC primary support policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "policy_version", "purpose", "canonicalization_profile", "proposition_identity", "source_profile_contract", "support_semantics", "conflict_and_defeat", "supersession", "freshness", "confirmatory_use_constraints"],
  "properties": {
    "policy_id": {"const": "eac-primary-support"},
    "policy_version": {"const": 1},
    "purpose": {"type": "string", "minLength": 1},
    "canonicalization_profile": {"type": "object", "additionalProperties": false, "required": ["standard", "encoding", "duplicate_object_keys", "hash_algorithm", "canonical_form_scope"], "properties": {"standard": {"const": "RFC8785-JCS"}, "encoding": {"const": "UTF-8"}, "duplicate_object_keys": {"const": "forbidden"}, "hash_algorithm": {"const": "SHA-256"}, "canonical_form_scope": {"type": "string", "minLength": 1}}},
    "proposition_identity": {"type": "object", "additionalProperties": false, "required": ["required_fields", "arguments_rule", "stable_tracked_proposition", "same_tracked_proposition", "temporal_scope_rule", "dynamic_fluent_rule", "different_temporal_proposition_rule", "contradiction", "scope_overlap"], "properties": {"required_fields": {"const": ["namespace", "predicate", "arguments", "temporal_scope", "polarity"]}, "arguments_rule": {"type": "string", "minLength": 1}, "stable_tracked_proposition": {"type": "string", "minLength": 1}, "same_tracked_proposition": {"type": "string", "minLength": 1}, "temporal_scope_rule": {"type": "string", "minLength": 1}, "dynamic_fluent_rule": {"type": "string", "minLength": 1}, "different_temporal_proposition_rule": {"type": "string", "minLength": 1}, "contradiction": {"type": "string", "minLength": 1}, "scope_overlap": {"type": "string", "minLength": 1}}},
    "source_profile_contract": {"type": "object", "additionalProperties": false, "required": ["required", "identity_fields", "frozen_before_confirmatory_use", "same_in_advisory_and_authority", "rules"], "properties": {"required": {"const": true}, "identity_fields": {"const": ["profile_id", "profile_version", "detached_profile_sha256"]}, "frozen_before_confirmatory_use": {"const": true}, "same_in_advisory_and_authority": {"const": true}, "rules": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}}},
    "support_semantics": {"type": "object", "additionalProperties": false, "required": ["sufficient_roots", "unverified_peer_report", "corroboration", "derived_claims", "same_action_legality_probe"], "properties": {
      "sufficient_roots": {"type": "object", "additionalProperties": false, "required": ["direct_observation", "trusted_tool_result", "visible_action_outcome"], "properties": {"direct_observation": {"type": "string", "minLength": 1}, "trusted_tool_result": {"type": "string", "minLength": 1}, "visible_action_outcome": {"type": "string", "minLength": 1}}},
      "unverified_peer_report": {"type": "object", "additionalProperties": false, "required": ["sufficient_alone_for_world_state_epre", "allowed_uses", "multiple_report_promotion"], "properties": {"sufficient_alone_for_world_state_epre": {"const": false}, "allowed_uses": {"const": ["claim_generation", "evidence_gathering_trigger", "clarification_trigger", "corroboration_subject"]}, "multiple_report_promotion": {"const": "forbidden"}}},
      "corroboration": {"type": "object", "additionalProperties": false, "required": ["rule", "source_identity", "independence", "same_source_repetition", "semantic_effect"], "properties": {"rule": {"type": "string"}, "source_identity": {"type": "string"}, "independence": {"type": "string"}, "same_source_repetition": {"const": "never_independent"}, "semantic_effect": {"type": "string"}}},
      "derived_claims": {"type": "object", "additionalProperties": false, "required": ["allowed", "rule", "self_support", "unsupported_cycle", "implicit_derivation"], "properties": {"allowed": {"const": true}, "rule": {"type": "string"}, "self_support": {"const": "forbidden"}, "unsupported_cycle": {"const": "forbidden"}, "implicit_derivation": {"const": "forbidden"}}},
      "same_action_legality_probe": {"type": "string", "minLength": 1}
    }},
    "conflict_and_defeat": {"$ref": "#/$defs/nonemptyStringObject"},
    "supersession": {"type": "object", "additionalProperties": false, "required": ["explicit_only", "authorized_rule", "ordering", "effect", "implicit_supersession"], "properties": {"explicit_only": {"const": true}, "authorized_rule": {"type": "string"}, "ordering": {"type": "string"}, "effect": {"type": "string"}, "implicit_supersession": {"const": "forbidden"}}},
    "freshness": {"type": "object", "additionalProperties": false, "required": ["wall_clock_ttl", "implicit_expiration", "support_lost_only_on", "adapter_aging_rule"], "properties": {"wall_clock_ttl": {"const": "none"}, "implicit_expiration": {"const": "forbidden"}, "support_lost_only_on": {"const": ["explicit_invalidation", "explicit_supersession", "relevant_scope_change", "support_policy_change", "source_profile_change", "evidence_revision", "predeclared_adapter_aging_event"]}, "adapter_aging_rule": {"type": "string"}}},
    "confirmatory_use_constraints": {"type": "object", "additionalProperties": false, "required": ["immutable", "policy_change_requires_new_version", "scenario_specific_change", "post_outcome_tuning", "advisory_authority_policy_difference"], "properties": {"immutable": {"const": true}, "policy_change_requires_new_version": {"const": true}, "scenario_specific_change": {"const": "forbidden"}, "post_outcome_tuning": {"const": "forbidden"}, "advisory_authority_policy_difference": {"const": "forbidden"}}}
  },
  "$defs": {
    "nonemptyStringObject": {"type": "object", "additionalProperties": false, "required": ["conflict_eligibility", "symmetry", "peer_report_rule", "derived_claim_rule", "resolution"], "properties": {"conflict_eligibility": {"type": "string", "minLength": 1}, "symmetry": {"type": "string", "minLength": 1}, "peer_report_rule": {"type": "string", "minLength": 1}, "derived_claim_rule": {"type": "string", "minLength": 1}, "resolution": {"type": "string", "minLength": 1}}}
  }
}
